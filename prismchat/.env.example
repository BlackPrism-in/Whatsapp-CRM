# ---------------------------------------------------------------------------
# PrismChat — environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# App
APP_NAME="PrismChat"
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL). pgvector recommended for AI knowledge base.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prismchat?schema=public"
# Supabase: use the POOLED url (6543, ?pgbouncer=true) above for the app,
# and the DIRECT url (5432) here for `prisma migrate deploy`.
DIRECT_URL=""

# Auth.js (NextAuth v5)
AUTH_SECRET="change-me-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Redis (BullMQ background jobs)
REDIS_URL="redis://localhost:6379"

# S3 / object storage (AWS S3, Cloudflare R2, or MinIO)
S3_REGION="us-east-1"
S3_BUCKET="prismchat"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT="" # set for R2/MinIO; leave blank for AWS S3

# Realtime (hosted Pusher, or self-hosted Soketi)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="mt1"
PUSHER_HOST="" # set for Soketi
PUSHER_PORT=""
PUSHER_TLS="false"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"
NEXT_PUBLIC_PUSHER_HOST=""
NEXT_PUBLIC_PUSHER_PORT=""

# Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# WhatsApp Cloud API (Meta)
META_APP_ID=""
NEXT_PUBLIC_META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v21.0"
NEXT_PUBLIC_META_CONFIG_ID=""

WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Broadcast throttling — Meta caps Cloud API throughput (~80 msg/sec default,
# lower for new numbers) and restricts numbers that burst. 20/sec sends 5,000
# messages in ~4 min. Raise once the number reaches a higher messaging tier.
BROADCAST_RATE_LIMIT="20"
BROADCAST_ATTEMPTS="5"

# AI providers (default Anthropic)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Web push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@prismchat.app"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Transactional email (team invites) — resend.com
RESEND_API_KEY=""

# Email (system SMTP fallback; workspaces configure their own)
MAIL_HOST=""
MAIL_PORT="587"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="hello@prismchat.app"
MAIL_FROM_NAME="PrismChat"

# Monitoring
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Encryption key for at-rest credential fields (32 bytes base64)
ENCRYPTION_KEY="change-me-with-openssl-rand-base64-32"
